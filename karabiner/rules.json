    {
      "description": "Stickshift: Home tap = paste, double tap = paste image (Ctrl+V), hold = ChatGPT \"Your dot\"",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "ac_home"
          },
          "to": [
            {
              "key_code": "v",
              "modifiers": [
                "left_control"
              ]
            },
            {
              "set_variable": {
                "name": "stickshift_home_tap",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            },
            {
              "type": "variable_if",
              "name": "stickshift_home_tap",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "ac_home"
          },
          "to": [
            {
              "set_variable": {
                "name": "stickshift_home_tap",
                "value": 1
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "v",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "to_if_held_down": [
            {
              "shell_command": "open codex://dots"
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "stickshift_home_tap",
                  "value": 0
                }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "stickshift_home_tap",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 350
          },
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            }
          ]
        }
      ]
    },
