    {
      "description": "Stickshift: hold Menu = jump to kaza and dictate a command",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "menu"
          },
          "to": [
            {
              "shell_command": "open -n -g -a '__HOME__/Applications/BoyaCheck.app'"
