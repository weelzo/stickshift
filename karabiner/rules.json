{
  "title": "Stickshift",
  "rules": [
    {
      "description": "Stickshift: ChatGPT: Up/Down = previous/next chat, hold Select = new chat, mic = ChatGPT dictation (Right Command = its single-tap shortcut)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow"
          },
          "to": [
            {
              "key_code": "open_bracket",
              "modifiers": [
                "left_option",
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow"
          },
          "to": [
            {
              "key_code": "close_bracket",
              "modifiers": [
                "left_option",
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "keypad_enter"
          },
          "to_if_alone": [
            {
              "key_code": "return_or_enter"
            }
          ],
          "to_if_held_down": [
            {
              "key_code": "n",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "ac_search"
          },
          "to": [
            {
              "shell_command": "open -n -g -a '__HOME__/Applications/BoyaCheck.app'"
            },
            {
              "key_code": "right_command"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 369,
                  "product_id": 1071
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            }
          ]
        }
      ]
    },
